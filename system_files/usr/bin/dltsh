#!/usr/bin/env bash

BOX_CONF=/etc/distrobox/dltos.ini
BOX_NAME=dltos

find_box() {
	if ! command -v distrobox 2>&1 >/dev/null; then
		return 1
	fi

	distrobox list --no-color | awk 'NR > 1 { print $3 }' | grep -qx "$BOX_NAME"
}

confirm() {
	if [ $# -ge 1 ]; then
		msg=$1
	else
		msg="Confirm?"
	fi

	while :; do
		printf "$msg [Y/n] "
		IFS= read -r ans

		case $ans in
		y | Y | yes | YES | Yes | *)
			return 0
			;;
		n | N | no | NO | No)
			return 1
			;;
		esac
	done
}

deprecated_main() {
	if find_box "$BOX_NAME"; then
		exec distrobox enter "$BOX_NAME"
	else
		if confirm "Create and run dltos distrobox?"; then
			distrobox assemble create --file "$BOX_CONF"
			exec distrobox enter "$BOX_NAME"
		else
			exec "$SHELL"
		fi
	fi
}

main() {
	STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dltsh"
	COUNTER_FILE="$STATE_DIR/warncnt"

	mkdir -p "$STATE_DIR"

	[ -f "$COUNTER_FILE" ] || echo 0 >"$COUNTER_FILE"
	count=$(<"$COUNTER_FILE")

	if [ "$count" -lt 5 ]; then
		echo "WARNING: /usr/bin/dltsh was deprecated in favor of /bin/zsh (host), which is now the default for DLT OS!"
		echo $((count + 1)) >"$COUNTER_FILE"
	fi

	exec /bin/zsh
}

main
