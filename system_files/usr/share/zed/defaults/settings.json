// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // --- Appearance ---
  "theme": {
    "mode": "dark",
    "light": "Noctalia Light Transparent",
    "dark": "Noctalia Dark Transparent",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "ui_font_size": 16.0,
  "ui_font_weight": 400.0,
  "buffer_font_size": 16.0,
  "buffer_font_family": "CaskaydiaCove Nerd Font Propo",
  "buffer_font_weight": 500.0,
  "buffer_line_height": {
    "custom": 1.4,
  },
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "font_family": "CaskaydiaMono Nerd Font Propo",
    "font_size": 15.0,
    "font_weight": 400.0,
    "line_height": {
      "custom": 1.1,
    },
  },

  // --- UI ---
  "title_bar": {
    "show_branch_status_icon": true,
    "show_user_menu": true,
    "button_layout": "",
    "show_user_picture": false,
    "show_onboarding_banner": true,
    "show_sign_in": false,
    "show_project_items": true,
    "show_branch_name": true,
    "show_menus": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "git_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },

  // --- Editor ---
  "preferred_line_length": 120,
  "soft_wrap": "bounded",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // --- Languages ---
  "languages": {
    "Shell Script": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["--filename", "{buffer_path}"],
        },
      },
    },
  },

  // --- Tooling ---
  "use_podman": true,
  "disable_ai": true,
  "inline_code_actions": false,
  },

  // --- Security ---
  "session": {
    "trust_all_worktrees": true,
  },

  // --- Privacy ---
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
